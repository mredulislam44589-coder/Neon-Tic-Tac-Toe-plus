<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
import { getAuth, signInAnonymously, signInWithCustomToken, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
import { getFirestore, doc, setDoc, updateDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

const $ = id => document.getElementById(id);

// Firebase Setup
const appId = typeof __app_id !== 'undefined' ? __app_id : 'neon-tictactoe-app';
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "demo", authDomain: "demo", projectId: "demo" };
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

let currentUser = null;
let coins = parseInt(localStorage.getItem('tictactoe_coins') || '100');
let playerName = localStorage.getItem('tictactoe_player_name') || 'Guest Player';
let board = Array(9).fill('');
let turn = 'X';
let ended = false;
let mode = 'ai'; // 'ai', 'friend', 'online'
let difficulty = 'medium';
let history = [];
let matchEvaluated = false;

// Online Multiplayer state
let currentRoomId = null;
let mySymbol = 'X';
let unsubscribeRoom = null;
let unsubscribeRoomsList = null;

function showMsg(title, text) {
  $('msgTitle').textContent = title;
  $('msgBody').textContent = text;
  $('msgModal').classList.remove('hide');
}
$('closeMsgBtn').onclick = () => $('msgModal').classList.add('hide');

async function initAuth() {
  try {
    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
      const userCredential = await signInWithCustomToken(auth, __initial_auth_token);
      currentUser = userCredential.user;
    } else {
      const userCredential = await signInAnonymously(auth);
      currentUser = userCredential.user;
    }
  } catch (err) {
    console.warn("Auth initialization fallback:", err);
  }
}
initAuth();

function updateCoinsDisplay() {
  if ($('coinCount')) $('coinCount').textContent = coins;
  if ($('gameCoinCount')) $('gameCoinCount').textContent = coins;
  localStorage.setItem('tictactoe_coins', coins);
}

function updatePlayerBadge() {
  if ($('playerBadge')) $('playerBadge').textContent = `Player: ${playerName}`;
  if ($('settingsNameInput')) $('settingsNameInput').value = playerName;
  localStorage.setItem('tictactoe_player_name', playerName);
}

function showScreen(screenId) {
  ['authScreen', 'mainMenu', 'roomsScreen', 'gameScreen'].forEach(id => {
    if ($(id)) $(id).classList.add('hide');
  });
  if ($(screenId)) $(screenId).classList.remove('hide');
}

// Authentication button bindings
$('playGuestBtn').onclick = () => showScreen('mainMenu');

$('googleSignInBtn').onclick = async () => {
  try {
    if (!auth.currentUser) await initAuth();
    const provider = new GoogleAuthProvider();
    const result = await signInWithPopup(auth, provider);
    currentUser = result.user;
    if (currentUser.displayName) {
      playerName = currentUser.displayName;
    }
    updatePlayerBadge();
    showMsg("Success", `Signed in successfully as ${playerName}!`);
    showScreen('mainMenu');
  } catch (err) {
    console.error("Google sign-in error:", err);
    showMsg("Sign-In Notice", "Google Sign-In popup closed or unavailable in current preview mode. Continuing as Guest!");
    showScreen('mainMenu');
  }
};

$('emailSignInBtn').onclick = () => {
  showMsg("Email Sign In", "Please enter your nickname in settings or sign in with Google for full cloud sync.");
  showScreen('mainMenu');
};

$('aboutBtn').onclick = () => {
  showMsg("About", "Neon TicTacToe v2.5 — Live Multiplayer with real-time room hosting, custom AI, and coin stakes!");
};

$('authBackBtn').onclick = () => showScreen('mainMenu');
$('authSettingsBtn').onclick = () => $('settingsModal').classList.remove('hide');
$('homeBtn').onclick = () => showScreen('authScreen');

$('roomsBackBtn').onclick = () => {
  if (unsubscribeRoomsList) unsubscribeRoomsList();
  showScreen('mainMenu');
};

// Settings Modal Controls
$('menuSettings').onclick = () => $('settingsModal').classList.remove('hide');
$('gameSettings').onclick = () => $('settingsModal').classList.remove('hide');
$('closeSettingsBtn').onclick = () => $('settingsModal').classList.add('hide');
$('saveSettingsBtn').onclick = () => {
  const newName = $('settingsNameInput').value.trim();
  if (newName) playerName = newName;
  difficulty = $('difficultySelect').value;
  updatePlayerBadge();
  $('settingsModal').classList.add('hide');
};

// Game Start Triggers
$('menuAI').onclick = () => startNewGame('ai');
if ($('passAndPlayBtn')) $('passAndPlayBtn').onclick = () => startNewGame('friend');
$('menuCreateRoom').onclick = createOnlineRoom;
$('menuBrowseRooms').onclick = openRoomsBrowser;

$('gameBack').onclick = () => {
  if (unsubscribeRoom) unsubscribeRoom();
  showScreen('mainMenu');
};

function startNewGame(selectedMode) {
  mode = selectedMode;
  board = Array(9).fill('');
  turn = 'X';
  ended = false;
  matchEvaluated = false;
  history = [];

  showScreen('gameScreen');
  renderBoard();
}

async function createOnlineRoom() {
  if (!auth.currentUser) await initAuth();
  if (!currentUser) currentUser = auth.currentUser;

  if (!currentUser) {
    showMsg("Connecting...", "Authenticating with server, please wait a moment and try again.");
    return;
  }

  const roomTitle = `${playerName}'s Room`;
  const roomId = 'room_' + Math.floor(1000 + Math.random() * 9000);
  currentRoomId = roomId;
  mySymbol = 'X';
  mode = 'online';

  const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', roomId);
  const roomData = {
    id: roomId,
    title: roomTitle,
    hostName: playerName,
    hostId: currentUser ? currentUser.uid : 'anon',
    guestName: null,
    guestId: null,
    board: Array(9).fill(''),
    turn: 'X',
    status: 'waiting', 
    winner: null
  };

  try {
    await setDoc(roomRef, roomData);
    listenToRoom(roomId);
    startNewGame('online');
  } catch (err) {
    console.error("Create room error:", err);
    showMsg("Error", "Could not create room. Please check connection.");
  }
}

function openRoomsBrowser() {
  showScreen('roomsScreen');
  fetchRoomsList();
}

$('refreshRoomsBtn').onclick = fetchRoomsList;

async function fetchRoomsList() {
  const container = $('roomsListContainer');
  container.innerHTML = '<div style="text-align:center; color:#94a3b8; margin-top:20px;">Scanning for active rooms...</div>';

  if (!auth.currentUser) await initAuth();
  if (!currentUser) currentUser = auth.currentUser;

  if (!currentUser) {
    container.innerHTML = '<div style="text-align:center; color:#f43f5e;">Authentication failed. Please check internet connection.</div>';
    return;
  }

  const roomsCol = collection(db, 'artifacts', appId, 'public', 'data', 'rooms');
  
  if (unsubscribeRoomsList) unsubscribeRoomsList();

  unsubscribeRoomsList = onSnapshot(roomsCol, (snapshot) => {
    container.innerHTML = '';
    let count = 0;
    snapshot.forEach((docSnap) => {
      const room = docSnap.data();
      if (room && room.status === 'waiting') {
        count++;
        const card = document.createElement('div');
        card.className = 'room-card';
        card.style.cssText = 'background: rgba(15, 23, 42, 0.8); border: 2px solid var(--neon-cyan); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);';
        card.innerHTML = `
          <div>
            <div style="font-weight: 800; font-size: 16px; color: #fff;">🏰 ${room.title || room.hostName + "'s Room"}</div>
            <div style="font-size: 12px; color: #94a3b8;">Host: ${room.hostName} • Code: ${room.id}</div>
          </div>
          <button style="background: var(--neon-cyan); color: #0b0f19; border: none; font-weight: 900; padding: 8px 16px; border-radius: 10px; cursor: pointer;">JOIN</button>
        `;
        card.querySelector('button').onclick = () => joinOnlineRoom(room.id);
        container.appendChild(card);
      }
    });

    if (count === 0) {
      container.innerHTML = '<div style="text-align:center; color:#cbd5e1; margin-top:30px;">No open rooms found right now.<br><br>Click "CREATE MULTIPLAYER ROOM" to host one!</div>';
    }
  }, (err) => {
    console.error("Rooms fetch error:", err);
    container.innerHTML = '<div style="text-align:center; color:#f43f5e;">Error connecting to live room list.</div>';
  });
}

async function joinOnlineRoom(roomId) {
  if (!auth.currentUser) await initAuth();
  if (!currentUser) currentUser = auth.currentUser;

  currentRoomId = roomId;
  mySymbol = 'O';
  mode = 'online';

  const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', roomId);
  try {
    await updateDoc(roomRef, {
      guestName: playerName,
      guestId: currentUser ? currentUser.uid : 'guest',
      status: 'playing'
    });
    listenToRoom(roomId);
    startNewGame('online');
  } catch (err) {
    console.error("Join room error:", err);
    showMsg("Error", "Unable to join room. It might be full or closed.");
  }
}

function listenToRoom(roomId) {
  if (unsubscribeRoom) unsubscribeRoom();
  const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', roomId);

  unsubscribeRoom = onSnapshot(roomRef, (docSnap) => {
    if (!docSnap.exists()) return;
    const data = docSnap.data();

    board = data.board;
    turn = data.turn;

    if (data.status === 'waiting') {
      $('status').textContent = `⏳ Waiting for Player 2 to join... (Room: ${data.title || roomId})`;
    } else if (data.status === 'playing') {
      const isMyTurn = turn === mySymbol;
      const opponentName = mySymbol === 'X' ? (data.guestName || "Player 2") : data.hostName;
      const turnName = isMyTurn ? "Your Turn" : opponentName;
      $('status').textContent = `${turnName} (${turn})`;
    }

    const winLine = checkWin(board);
    if (winLine) {
      ended = true;
      const winnerSymbol = board[winLine[0]];
      const winnerName = winnerSymbol === 'X' ? data.hostName : (data.guestName || "Player 2");
      
      if (!matchEvaluated) {
        matchEvaluated = true;
        if (winnerSymbol === mySymbol) {
          coins += 15;
        } else {
          coins = Math.max(0, coins - 15);
        }
        updateCoinsDisplay();
      }

      $('status').textContent = winnerSymbol === mySymbol ? `🎉 You Win! (+15 🪙)` : `💀 ${winnerName} Wins! (-15 🪙)`;
    } else if (board.every(Boolean)) {
      ended = true;
      $('status').textContent = "🤝 Game Drawn!";
    }

    renderBoardStateOnly(winLine);
  }, (err) => {
    console.error("Room sync error:", err);
  });
}

function renderBoard() {
  renderBoardStateOnly(checkWin(board));
}

function renderBoardStateOnly(winLine) {
  const b = $('board');
  b.innerHTML = '';
  board.forEach((val, i) => {
    const btn = document.createElement('div');
    btn.className = 'cell ' + (val ? val.toLowerCase() : '');
    btn.textContent = val === 'X' ? '✕' : val === 'O' ? '○' : '';
    if (winLine && winLine.includes(i)) {
      btn.classList.add('win');
    }
    btn.onclick = () => play(i);
    b.appendChild(btn);
  });

  if (mode !== 'online' && !ended) {
    $('status').textContent = `Turn: Player ${turn}`;
  }
}

async function play(i) {
  if (ended || board[i]) return;

  if (mode === 'online') {
    if (turn !== mySymbol) return; 
    const newBoard = [...board];
    newBoard[i] = mySymbol;
    const nextTurn = mySymbol === 'X' ? 'O' : 'X';

    const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', currentRoomId);
    await updateDoc(roomRef, {
      board: newBoard,
      turn: nextTurn
    });
    return;
  }

  history.push({ board: [...board], turn });
  board[i] = turn;
  
  const winLine = checkWin(board);
  if (winLine) {
    ended = true;
    if (!matchEvaluated) {
      matchEvaluated = true;
      if (mode === 'ai') {
        if (turn === 'X') {
          coins += 15;
          $('status').textContent = '🎉 You Win! (+15 🪙)';
        } else {
          coins = Math.max(0, coins - 15);
          $('status').textContent = '💀 AI Won! (-15 🪙)';
        }
      } else {
        $('status').textContent = `🎉 Player ${turn} Wins!`;
      }
      updateCoinsDisplay();
    }
    renderBoard();
    return;
  }

  if (board.every(Boolean)) {
    ended = true;
    $('status').textContent = "🤝 Game Drawn!";
    renderBoard();
    return;
  }

  turn = turn === 'X' ? 'O' : 'X';
  renderBoard();

  if (mode === 'ai' && turn === 'O' && !ended) {
    setTimeout(aiMove, 300);
  }
}

function aiMove() {
  const emptyIndices = board.map((v, i) => v === '' ? i : null).filter(v => v !== null);
  if (emptyIndices.length === 0) return;
  
  let move;
  if (difficulty === 'easy') {
    move = emptyIndices[Math.floor(Math.random() * emptyIndices.length)];
  } else {
    for (let idx of emptyIndices) {
      let temp = [...board];
      temp[idx] = 'O';
      if (checkWin(temp)) { move = idx; break; }
    }
    if (move === undefined) {
      for (let idx of emptyIndices) {
        let temp = [...board];
        temp[idx] = 'X';
        if (checkWin(temp)) { move = idx; break; }
      }
    }
    if (move === undefined) {
      move = emptyIndices[Math.floor(Math.random() * emptyIndices.length)];
    }
  }

  play(move);
}

function checkWin(b) {
  const lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
  for (let l of lines) {
    if (b[l[0]] && b[l[0]] === b[l[1]] && b[l[1]] === b[l[2]]) return l;
  }
  return null;
}

$('restartBtn').onclick = async () => {
  if (mode === 'online') {
    const roomRef = doc(db, 'artifacts', appId, 'public', 'data', 'rooms', currentRoomId);
    await updateDoc(roomRef, {
      board: Array(9).fill(''),
      turn: 'X',
      status: 'playing'
    });
  } else {
    startNewGame(mode);
  }
};

$('undoBtn').onclick = () => {
  if (mode !== 'online' && history.length > 0 && !ended) {
    const last = history.pop();
    board = last.board;
    turn = last.turn;
    renderBoard();
  }
};

// Initial State Updates
updateCoinsDisplay();
updatePlayerBadge();
</script>
